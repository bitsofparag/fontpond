---
import Controls from '../components/Controls.astro';
import PreviewFrame from '../components/PreviewFrame.astro';
import ScorePanel from '../components/ScorePanel.astro';
import { DEFAULT_FONT_PAIR, FONT_CATALOG, findFont } from '../domain/fonts';
import { DEFAULT_LAYOUT_ID, LAYOUT_CATALOG } from '../domain/layouts';
import { scorePair } from '../domain/scoring';
import '../styles/global.css';
import '../styles/shell.css';
import '../styles/controls.css';
import '../styles/previews.css';
import '../styles/preview-structured.css';
import '../styles/score.css';
import '../styles/responsive.css';

const heading = findFont(DEFAULT_FONT_PAIR.headingId);
const body = findFont(DEFAULT_FONT_PAIR.bodyId);
if (!heading.ok || !body.ok)
  throw new Error('Default font catalog is invalid.');
const layoutDescription = 'Headline, action, image, benefits';
const initialScore = scorePair({
  heading: heading.value,
  body: body.value,
  layoutId: DEFAULT_LAYOUT_ID,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Test heading and body font pairs in realistic frontend layouts."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23ec3013%22/><text x=%2250%22 y=%2268%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2255%22 font-family=%22Arial%22 font-weight=%22700%22>F</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Fontpond · Test font pairings in context</title>
  </head>
  <body>
    <div class="fontpond-app">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Fontpond home">
          <span class="brand-mark" aria-hidden="true">F</span>
          <span class="brand-copy">
            <strong>Fontpond</strong>
            <small>Type pairing sandbox</small>
          </span>
        </a>
        <div class="header-context">
          <p>Test a heading and body font where they will actually be used.</p>
        </div>
      </header>

      <main class="app-shell">
        <Controls
          fonts={FONT_CATALOG}
          layouts={LAYOUT_CATALOG}
          headingId={heading.value.id}
          bodyId={body.value.id}
          layoutId={DEFAULT_LAYOUT_ID}
        />
        <PreviewFrame
          headingName={heading.value.name}
          bodyName={body.value.name}
          headingStack={heading.value.cssStack}
          bodyStack={body.value.cssStack}
          layoutDescription={layoutDescription}
        />
        <ScorePanel score={initialScore} />
      </main>
    </div>

    <script>
      import { startFontpond } from '../client/fontpond';

      void startFontpond(document);
    </script>
  </body>
</html>

---
import BlogArticle from './previews/BlogArticle.astro';
import DashboardCard from './previews/DashboardCard.astro';
import LandingHero from './previews/LandingHero.astro';
import PricingCard from './previews/PricingCard.astro';

interface Props {
  headingName: string;
  bodyName: string;
  headingStack: string;
  bodyStack: string;
  layoutDescription: string;
}

const { headingName, bodyName, headingStack, bodyStack, layoutDescription } =
  Astro.props;
---

<section class="app-column preview-panel" aria-labelledby="preview-title">
  <header class="column-strip preview-strip">
    <div>
      <h2 id="preview-title">Live preview</h2>
      <p id="layout-description">{layoutDescription}</p>
    </div>
    <p id="pair-label" class="pair-label" aria-live="polite">
      <span id="heading-name" style={`font-family: ${headingStack}`}>
        {headingName}
      </span>
      <span aria-hidden="true">/</span>
      <span id="body-name" style={`font-family: ${bodyStack}`}>{bodyName}</span>
    </p>
  </header>

  <div class="preview-scroll">
    <div
      id="preview"
      class="preview-canvas"
      data-testid="preview"
      aria-label={`${headingName} headings with ${bodyName} body text`}
      style={`--heading-font: ${headingStack}; --body-font: ${bodyStack};`}
    >
      <LandingHero />
      <BlogArticle />
      <DashboardCard />
      <PricingCard />
    </div>
  </div>
</section>

---
import PreviewPane from './PreviewPane.astro';

interface Props {
  headingName: string;
  bodyName: string;
  headingStack: string;
  bodyStack: string;
  layoutDescription: string;
}

const { headingName, bodyName, headingStack, bodyStack, layoutDescription } =
  Astro.props;
---

<section class="app-column preview-panel" aria-labelledby="preview-title">
  <header class="column-strip preview-strip">
    <div>
      <h2 id="preview-title">Live preview</h2>
      <p id="layout-description">{layoutDescription}</p>
    </div>
    <p id="pair-label" class="pair-label" aria-live="polite">
      <span id="heading-name" style={`font-family: ${headingStack}`}>
        {headingName}
      </span>
      <span aria-hidden="true">/</span>
      <span id="body-name" style={`font-family: ${bodyStack}`}>{bodyName}</span>
    </p>
  </header>

  <form class="preview-toolbar" aria-label="Preview settings">
    <fieldset class="setting-group" data-sheet-controls>
      <legend class="visually-hidden">Sheet theme</legend>
      <span aria-hidden="true">Sheet</span>
      <div class="segmented-control">
        <button type="button" data-sheet-control="light" aria-pressed="true">
          Light
        </button>
        <button type="button" data-sheet-control="dark" aria-pressed="false">
          Dark
        </button>
      </div>
    </fieldset>
    <fieldset class="setting-group" data-view-controls>
      <legend class="visually-hidden">Preview view</legend>
      <span aria-hidden="true">View</span>
      <div class="segmented-control">
        <button type="button" data-view-control="single" aria-pressed="true">
          Single
        </button>
        <button type="button" data-view-control="split" aria-pressed="false">
          Split
        </button>
      </div>
    </fieldset>
    <output id="preview-view-hint" aria-live="polite">
      One sheet at a time
    </output>
  </form>

  <div class="preview-scroll">
    <div
      id="preview"
      class="preview-canvas"
      data-testid="preview"
      data-sheet-theme="light"
      aria-label={`${headingName} headings with ${bodyName} body text`}
      style={`--heading-font: ${headingStack}; --body-font: ${bodyStack};`}
    >
      <PreviewPane />
    </div>
  </div>
</section>

<article
  class="template template-dashboard"
  data-layout="dashboard-card"
  hidden
>
  <header class="dashboard-heading">
    <div>
      <p class="template-kicker">Sample habitat data</p>
      <h2>Wetland overview</h2>
    </div>
    <span class="status-label">Monitoring active</span>
  </header>
  <div class="metric-grid">
    <section class="metric metric-primary">
      <span>Water temperature</span>
      <strong>18.6°C</strong>
      <small>Within the seasonal range</small>
    </section>
    <section class="metric">
      <span>Plant cover</span>
      <strong>82%</strong>
      <small>Up 4% this month</small>
    </section>
    <section class="metric">
      <span>Species observed</span>
      <strong>14</strong>
      <small>Across three survey zones</small>
    </section>
  </div>
  <section class="dashboard-note">
    <h3>Field note</h3>
    <p>
      Water levels remain stable after a dry week. The north bank shows new reed
      growth.
    </p>
  </section>
</article>

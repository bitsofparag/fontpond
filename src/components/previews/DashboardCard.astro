<article
  class="template template-dashboard"
  data-layout="dashboard-card"
  hidden
>
  <header class="dashboard-heading">
    <div>
      <h2>Reservoir health</h2>
      <p>Updated 4 minutes ago · North basin</p>
    </div>
    <span class="status-label">Live</span>
  </header>
  <div class="metric-grid">
    <section class="metric metric-primary">
      <span>Surface clarity</span>
      <div>
        <strong>94%</strong>
        <small>Up 6 points since the spring reading.</small>
      </div>
    </section>
    <section class="metric">
      <span>Inflow</span>
      <div>
        <strong>12.4<small> m³/s</small></strong>
        <small>Steady for nine days.</small>
      </div>
    </section>
    <section class="metric">
      <span>Temperature</span>
      <div>
        <strong>11.8<small> °C</small></strong>
        <small>Within the seasonal band.</small>
      </div>
    </section>
  </div>
  <section class="dashboard-note">
    <h3>Sampling note</h3>
    <p>
      Numbers come from three fixed buoys. Small labels and dense figures are
      where a body font either holds up or gets muddy, so check them at this
      size.
    </p>
  </section>
</article>

---
import type { FontDefinition } from '../domain/fonts';
import type { LayoutDefinition, LayoutId } from '../domain/layouts';

interface Props {
  fonts: readonly FontDefinition[];
  layouts: readonly LayoutDefinition[];
  headingId: string;
  bodyId: string;
  layoutId: string;
}

const { fonts, layouts, headingId, bodyId, layoutId } = Astro.props;
const googleFonts = fonts.filter((font) => font.source === 'google');
const systemFonts = fonts.filter((font) => font.source === 'system');
const headingFont = fonts.find((font) => font.id === headingId);
const bodyFont = fonts.find((font) => font.id === bodyId);
const sourceLabel = (font: FontDefinition | undefined) =>
  `${font?.source === 'system' ? 'System' : 'Google'} · ${font?.category ?? 'unknown'}`;
const layoutCopy: Record<LayoutId, { name: string; description: string }> = {
  'landing-hero': {
    name: 'Landing hero',
    description: 'Headline, action, image, benefits',
  },
  'blog-article': {
    name: 'Blog article',
    description: 'Title, metadata, long copy, pull quote',
  },
  'dashboard-card': {
    name: 'Dashboard',
    description: 'Metrics, labels, status, small text',
  },
  'pricing-card': {
    name: 'Pricing',
    description: 'Plan, price, features, action',
  },
};
---

<section class="app-column controls-column" aria-labelledby="controls-title">
  <header class="column-strip">
    <h2 id="controls-title">Controls</h2>
  </header>

  <div class="controls-body">
    <div class="control-field">
      <div class="field-heading">
        <label for="heading-font"
          ><span aria-hidden="true">01</span> Heading font</label
        >
        <small id="heading-source">{sourceLabel(headingFont)}</small>
      </div>
      <select id="heading-font" class="input" name="heading-font">
        <optgroup label="Google">
          {
            googleFonts.map((font) => (
              <option value={font.id} selected={font.id === headingId}>
                {font.name}
              </option>
            ))
          }
        </optgroup>
        <optgroup label="System">
          {
            systemFonts.map((font) => (
              <option value={font.id} selected={font.id === headingId}>
                {font.name}
              </option>
            ))
          }
        </optgroup>
      </select>
    </div>

    <div class="control-field">
      <div class="field-heading">
        <label for="body-font"
          ><span aria-hidden="true">02</span> Body font</label
        >
        <small id="body-source">{sourceLabel(bodyFont)}</small>
      </div>
      <select id="body-font" class="input" name="body-font">
        <optgroup label="Google">
          {
            googleFonts.map((font) => (
              <option value={font.id} selected={font.id === bodyId}>
                {font.name}
              </option>
            ))
          }
        </optgroup>
        <optgroup label="System">
          {
            systemFonts.map((font) => (
              <option value={font.id} selected={font.id === bodyId}>
                {font.name}
              </option>
            ))
          }
        </optgroup>
      </select>
    </div>

    <div class="control-field layout-field">
      <p class="control-label"><span aria-hidden="true">03</span> Layout</p>
      <div
        class="layout-options"
        role="group"
        aria-label="Preview layout"
        data-layout-controls
      >
        {
          layouts.map((layout) => (
            <button
              type="button"
              data-layout-control={layout.id}
              data-description={layoutCopy[layout.id].description}
              aria-pressed={layout.id === layoutId}
            >
              <strong>{layoutCopy[layout.id].name}</strong>
              <span>{layoutCopy[layout.id].description}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="upload-field">
      <label for="local-font"
        ><span aria-hidden="true">04</span> Local font</label
      >
      <p>
        WOFF, WOFF2, TTF or OTF, up to 5 MB. It stays in this tab and is never
        uploaded or shared.
      </p>
      <input
        id="local-font"
        name="local-font"
        type="file"
        accept=".woff,.woff2,.ttf,.otf,font/woff,font/woff2,font/ttf,font/otf"
        aria-describedby="upload-note upload-status"
      />
      <p id="upload-status" class="upload-status" aria-live="polite"></p>
      <div
        id="uploaded-fonts"
        class="uploaded-fonts"
        aria-label="Uploaded font metadata"
        hidden
      >
      </div>
    </div>

    <p id="upload-note" class="control-note">
      Google fonts load only when you select them. System options use faces
      already on your device. Nothing here needs an account.
    </p>
    <p
      id="font-error"
      class="inline-error"
      role="status"
      aria-live="polite"
      hidden
    >
    </p>
  </div>
</section>
